# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# MCP App dashboard bundle (public/mcp-app/mcp-app.html): rebuilt by
# `npm run build:ui` (runs first in `npm run build`), but tracked so
# serverless deploys always serve the interactive dashboard.
# (The stale public/mcp-app/index.html placeholder stays untracked.)
/public/mcp-app/index.html

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env

# prisma local sqlite (postgres on deploy via DATABASE_URL)
prisma/*.db
prisma/*.db-journal

# prisma 7 generated client (rebuilt by postinstall `prisma generate`)
/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scraper HTTP cache (local-only, rebuilt on demand)
/.scratch/scrape-cache/

# personal salary dataset for the salary-lookup workflow CLI (never commit)
/host/job-hunter/workflow/salary-data.json

# assisted-apply Chrome session (logins, local-only, rebuilt on demand)
/.scratch/apply-chrome/
