# Prisma 7. SQLite locally (file must live under ./prisma, gitignored);
# Postgres on deploy (change the schema provider to "postgresql" + db push).
DATABASE_URL="file:./prisma/job-hunter.db"

# Local dev: leave MCP_AUTH_TOKEN empty for open access.
# Prod (Vercel): set MCP_AUTH_TOKEN and require Authorization: Bearer <token>.
MCP_AUTH_TOKEN=

# Optional OAuth 2.1 resource-server (Claude remote connector).
# OAUTH_ISSUER enables JWT verification via jose (any OIDC issuer: Auth0, Clerk, WorkOS, Stytch, Keycloak).
# OAUTH_AUDIENCE= (expected JWT aud, e.g. https://mcp.example.com/mcp; when unset, MCP_PUBLIC_URL is expected)
# OAUTH_JWKS_URI= (defaults to <issuer>/.well-known/jwks.json)
# OAUTH_REQUIRED_SCOPES= (space-separated, default "mcp:tools"; empty string explicitly opts into validity-only)
# MCP_PUBLIC_URL= (public MCP endpoint, e.g. https://mcp.example.com/mcp; feeds RFC 9728 discovery + aud fallback)
OAUTH_ISSUER=


# Optional. When absent, search-jobs degrades to WebSearch fallback.
BRIGHTDATA_API_KEY=

# Optional. Second link in the evaluate-job refinement chain
# (host-model sampling -> Groq -> heuristic scaffold unchanged).
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
