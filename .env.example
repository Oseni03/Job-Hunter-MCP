# Prisma 7. Postgres required for Better Auth (String[] scalar lists).
# Local: point at a Postgres instance; deploy: Neon/Vercel Postgres URL.
# Connection string lives in prisma.config.ts (Prisma 7), not schema.prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/jobhunter"

# Self-hosted OAuth 2.1 authorization server (Better Auth mcp() plugin).
# This app IS the issuer: tokens are minted at /api/auth/oauth2/* and verified
# on /mcp via JWKS. Set these in production:
# BETTER_AUTH_SECRET= (min 32 chars; required in prod, dev falls back to insecure default)
# BETTER_AUTH_URL= (public origin, e.g. https://mcp.example.com; defaults to MCP_PUBLIC_URL origin)
# MCP_PUBLIC_URL= (full public URL of the job-hunter server, e.g. https://mcp.example.com/job-hunter/mcp; resource identifier + discovery)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
MCP_PUBLIC_URL=

# Legacy static bearer (optional bypass, kept for backwards compatibility).
# Local dev: leave MCP_AUTH_TOKEN empty for open access.
# Prod: set MCP_AUTH_TOKEN to allow Authorization: Bearer <token> without OAuth.
MCP_AUTH_TOKEN=

# Legacy external OAuth 2.1 resource-server (deprecated, kept as fallback).
# Only used when Better Auth has NO Postgres DATABASE_URL: a Postgres
# DATABASE_URL takes precedence and OAUTH_ISSUER tokens are then ignored.
# OAUTH_ISSUER enables JWT verification via jose (any OIDC issuer: Auth0, Clerk, WorkOS, Stytch, Keycloak).
# OAUTH_AUDIENCE= (expected JWT aud, e.g. https://mcp.example.com/mcp; when unset, MCP_PUBLIC_URL is expected)
# OAUTH_JWKS_URI= (defaults to <issuer>/.well-known/jwks.json)
# OAUTH_REQUIRED_SCOPES= (space-separated, default "mcp:tools"; empty string explicitly opts into validity-only)
OAUTH_ISSUER=


# Optional. Second link in the evaluate-job refinement chain
# (host-model sampling -> Groq -> heuristic scaffold unchanged).
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
